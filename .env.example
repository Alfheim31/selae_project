# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings -> API). Without a .env, SELAE keeps its data in data/selae.json,
# but nobody can sign in, so registering and creating events won't work.

# Server only. Use the secret (service role) key, and never put it in the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Browser sign-in. The publishable (anon) key is safe to ship.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Email for organization sign-in details (a Gmail with 2-Step Verification and an app password works:
# host smtp.gmail.com, port 465). Without it, the superadmin sees each temporary password once instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=selae.noreply@gmail.com
SMTP_PASS=your-16-character-app-password
# The link in those emails (defaults to the address the superadmin is using)
# SELAE_APP_URL=https://selae.example.com

# Comma-separated Gmail addresses of the superadmins (they sign in with Google)
SELAE_SUPERADMINS=admin@gmail.com

# Offline venue only: 1 lets the laptop running SELAE manage every event from localhost.
# Leave it out everywhere else, or anyone using localhost can manage any event.
# SELAE_VENUE_LAPTOP=1
