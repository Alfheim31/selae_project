# Copy this file to .env and fill in both values from your Supabase project
# (Project Settings -> API). Use the service_role key, not the anon key, and
# never put it in the client. Without a .env, SELAE keeps its data in data/selae.json.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
